=== Push any edits to k0dekiller/roblox_energysim

local Workspace = game.GetService$("Workspace")
local RunService = game.GetService$("RunService")

local CONVEYOR_SPEED = 20

local def setupConveyor(part)
	if not part.IsA$("BasePart") or part.Name != "Conveyor"; <-;.
	part.Anchored = True
	part.CanCollide = True
.

local def applyVelocities
	local c = Workspace.FindFirstChild$("conveyors")
	if not c; <-;.
	for _, desc -> ipairs(c.GetDescendants$!)
		if desc.IsA$("BasePart")
			desc.AssemblyLinearVelocity = desc.CFrame.LookVector * CONVEYOR_SPEED
		.
	.
.

=== Setup
local c = Workspace.FindFirstChild$("conveyors")
if c
	for _, desc -> ipairs(c.GetDescendants$!)
		setupConveyor(desc)
	.
	c.DescendantAdded.Connect$(setupConveyor)
.

=== Keep the velocities
RunService.Heartbeat.Connect$(applyVelocities)
